{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "command-center",
  "description": "The Command Center window: full read access, command submission (typed or push-to-talk), spoken replies, the local semantic model's settings and its own window chrome.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "allow-get-assistant-snapshot",
    "allow-get-system-snapshot",
    "allow-get-runtime-info",
    "allow-list-activity",
    "allow-submit-command",
    "allow-get-application-catalog",
    "allow-refresh-application-catalog",
    "allow-get-integration-status",
    "allow-set-tray-labels",
    "allow-set-global-shortcut",
    "allow-hide-command-center",
    "allow-dismiss-assistant",
    "allow-preview-assistant-state",
    "allow-quit-app",
    "allow-get-voice-status",
    "allow-configure-voice",
    "allow-start-voice-capture",
    "allow-stop-voice-capture",
    "allow-cancel-voice-capture",
    "allow-speak-reply",
    "allow-stop-speaking",
    "allow-download-voice-model",
    "allow-cancel-voice-model-download",
    "allow-get-semantic-status",
    "allow-configure-semantic",
    "allow-download-semantic-model",
    "allow-cancel-semantic-model-download"
  ]
}
